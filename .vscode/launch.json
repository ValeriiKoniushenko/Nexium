{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Nexium",
            "program": "${workspaceFolder}/build/bin/TemplateGame",
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceMap": {
                "/proc/self/cwd": "${workspaceFolder}"
            },
            // Key performance flags:
            "expressions": "native",
            "initCommands": [
                "settings set target.preload-symbols false" // lazy symbol loading
            ],
            "postRunCommands": [],
            "stopOnEntry": false
        }
    ]
}