{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Nexium: configure Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Nexium: build Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "--parallel",
                "4",
                "--target",
                "TemplateGame"
            ],
            "dependsOn": "Nexium: configure Debug",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}
