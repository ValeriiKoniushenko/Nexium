{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TemplateGame (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/TemplateGame",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\""
        },
        {
            "name": "TemplateGame (GDB, catch exceptions)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/TemplateGame",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Stop at the throw site, including caught exceptions",
                    "text": "-interpreter-exec console \"catch throw\"",
                    "ignoreFailures": false
                }
            ],
            "stopAtEntry": false,
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\""
        },
        {
            "name": "Nexium_Tests (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Nexium_Tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\""
        },
        {
            "name": "Nexium_Tests (GDB, filter)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Nexium_Tests",
            "args": ["--gtest_filter=${input:gtestFilter}"],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "stopAtEntry": false,
            "miDebuggerArgs": "-iex \"set debuginfod enabled off\""
        }
    ],
    "inputs": [
        {
            "id": "gtestFilter",
            "type": "promptString",
            "description": "GoogleTest filter (e.g. InputRoutingTests.*)",
            "default": "*"
        }
    ]
}
