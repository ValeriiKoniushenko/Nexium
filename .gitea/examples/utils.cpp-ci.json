{
  "schema_version": 1,
  "project_id": "utils",
  "base_ref": "develop",
  "parallelism": {
    "build_job_divisor": 5
  },
  "cmake": {
    "arguments": [
      "-DUTILS_DISABLE_TESTS=OFF",
      "-DUTILS_DISABLE_BENCHMARKS=ON",
      "-DBUILD_UTILS_WITH_TEST_COVERAGE=OFF"
    ]
  },
  "analysis": {
    "excluded_paths": ["dependencies/", "docs/", "cmake/", "benchmarks/"],
    "clang_tidy_fail_on": "error"
  },
  "unit_tests": {
    "target": "UtilsTests",
    "command": ["{build_dir}/bin/UtilsTests"]
  },
  "valgrind": {
    "suppressions": [],
    "generate_suppressions": true
  },
  "artifacts": {
    "paths": ["{build_dir}/bin/UtilsTests"]
  }
}
