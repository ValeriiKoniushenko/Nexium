If:
  PathMatch: .*\.generated\.h
Diagnostics:
  Suppress: ["*"]
  UnusedIncludes: None

---

If:
  PathMatch: .*/build/_deps/.*
Diagnostics:
  Suppress: ["*"]
  UnusedIncludes: None

---

CompileFlags:
  Remove:
    - -W*
    - -fdeps-format=*
    - -fdeps-file=*
    - -fdeps-target=*
    - -fmodules-ts
    - -fmodule-mapper=*
    - -MD

Index:
  Background: Build